{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Laravel",
      "type": "shell",
      "command": "php artisan serve",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Run Vite Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Build Assets",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run All Services (Dev)",
      "type": "shell",
      "command": "composer dev",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Run PHPUnit Tests",
      "type": "shell",
      "command": "php artisan test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Pest Tests",
      "type": "shell",
      "command": "vendor/bin/pest",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "test"
    },
    {
      "label": "Laravel Pint (Fix)",
      "type": "shell",
      "command": "vendor/bin/pint",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Laravel Pint (Test)",
      "type": "shell",
      "command": "vendor/bin/pint --test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Clear Cache",
      "type": "shell",
      "command": "php artisan cache:clear && php artisan config:clear && php artisan route:clear && php artisan view:clear",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "composer install && npm install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run Migrations",
      "type": "shell",
      "command": "php artisan migrate",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Fresh Migrate with Seed",
      "type": "shell",
      "command": "php artisan migrate:fresh --seed",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
